# Copy to .env (gitignored) for local development. Real deployments should
# set these in the host's environment instead. Never commit real values.
# An empty value counts as unset.

# ── Local development ────────────────────────────────────────────────────────
# DEBUG on: a dev-only secret key, localhost hosts and localhost CORS origins
# are allowed automatically. Never enable DEBUG on a public server.
DJANGO_DEBUG=true

# ── Required when DJANGO_DEBUG is off ───────────────────────────────────────
# 50+ random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# DJANGO_SECRET_KEY=
# Comma-separated host names this API answers to (no "*").
# DJANGO_ALLOWED_HOSTS=api.example.com

# ── Cross-origin frontend ───────────────────────────────────────────────────
# Comma-separated origins (scheme://host[:port]) allowed to call the API from
# a browser. "*" is refused. With DEBUG on and this unset, any
# http://localhost / 127.0.0.1 port is allowed.
# DJANGO_CORS_ALLOWED_ORIGINS=https://flashcards.example.com

# ── Model (OpenAI) ───────────────────────────────────────────────────────────
# Without a key, /generate/ answers 503 and everything else still works.
# OPENAI_API_KEY=
# OpenAI SDK setting: point it at a local OpenAI-compatible stub to try
# generation without OpenAI (no cost, no data sent anywhere).
# OPENAI_BASE_URL=http://127.0.0.1:8765/v1
# Per model call, in seconds (default 60).
# OPENAI_TIMEOUT_SECONDS=60

# ── Upload limits ────────────────────────────────────────────────────────────
# FLASH_MAX_UPLOAD_MB=20
# FLASH_MAX_PDF_PAGES=200

# ── Abuse / cost controls ────────────────────────────────────────────────────
# Per client IP, "<count>/<second|minute|hour|day>".
# FLASH_THROTTLE_ANALYZE=30/hour
# FLASH_THROTTLE_GENERATE=10/hour
# FLASH_THROTTLE_READ=120/minute
# New decks per UTC day across ALL clients (0 turns generation off).
# FLASH_GENERATION_DAILY_LIMIT=100
# Where throttle counters live: locmem (per process, default) or database
# (shared by all workers; run `python manage.py createcachetable` once).
# FLASH_CACHE=locmem
# Number of reverse proxies in front of Django (so throttles see the real
# client IP in X-Forwarded-For). Leave unset when clients connect directly.
# DJANGO_NUM_PROXIES=1

# ── HTTPS (production; see README "Deployment caveats") ─────────────────────
# DJANGO_SECURE_PROXY_SSL_HEADER=true     # trust X-Forwarded-Proto from your proxy
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false

# DJANGO_LOG_LEVEL=INFO
